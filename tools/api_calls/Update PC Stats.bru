meta {
  name: Update PC Stats
  type: http
  seq: 22
}

post {
  url: http://{{notif_url}}/pcstats
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  cpu_temp: 65
  cpu_usage: 42
  cpu_speed: 4.8
  ram_used: 14
  ram_total: 32
  gpu_temp: 72
  gpu_usage: 85
  net_down: 12.4
  net_up: 2.1
}

settings {
  encodeUrl: true
  timeout: 0
}
